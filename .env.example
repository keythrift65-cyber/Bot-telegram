# Token que te da @BotFather
BOT_TOKEN=123456789:AAAA-tu-token-aqui

# Tu id numérico de Telegram (puedes verlo con @userinfobot)
ADMIN_ID=123456789

# (Opcional) Canal donde se publica la pregunta del día a las 9:00.
# Puede ser el @usuario del canal o su id numérico (empieza por -100).
# El bot tiene que ser administrador del canal con permiso para publicar.
# Si lo dejas vacío, la publicación en el canal está desactivada.
CHANNEL_ID=@tu_canal

# Usuario de tu bot, sin @ (para el botón "Practicar en el bot" del canal)
BOT_USERNAME=tu_bot

# (Opcional) Ruta del archivo de base de datos
# DB_PATH=./data/bot.sqlite
